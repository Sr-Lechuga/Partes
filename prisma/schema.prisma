generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id               String     @id @default(uuid())
  name             String
  defaultThreshold Int        @default(8) // RF-EMP-001 and RF-CFG-002
  currency         String     @default("UYU") // RNF-LOC-002
  status           String     @default("ACTIVE") // ACTIVE, INACTIVE for soft delete
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  employees Employee[]
  members   Membership[]

  @@map("companies")
}

// RF-USR-001 / RF-USR-002 / RF-USR-003 / RF-USR-004
// A Membership links a user (identified by firebaseUid) to a company with a role.
// Roles: ADMIN | HR | EMPLOYEE
// Status: ACTIVE | INACTIVE (soft delete — historical data persists)
model Membership {
  id          String   @id @default(uuid())
  companyId   String
  firebaseUid String   // Firebase user UID
  email       String   // Denormalized for display without extra auth calls
  name        String   // Denormalized display name
  role        String   @default("HR") // ADMIN | HR | EMPLOYEE
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  // A user can only have one active membership per company
  @@unique([companyId, firebaseUid])
  @@index([companyId, status])
  @@index([firebaseUid])
  @@map("memberships")
}

// RF-EMPL-001: Employee belongs to a company, threshold overrides company default
model Employee {
  id               String   @id @default(uuid())
  companyId        String
  name             String
  documentNumber   String   // CI or identification number
  phone            String?
  overtimeThreshold Int?    // If set, overrides company defaultThreshold (RF-EMPL-001)
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE for soft delete (RF-EMPL-005)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company       Company                @relation(fields: [companyId], references: [id])
  rateHistory   EmployeeRateHistory[]
  changeHistory EmployeeChangeHistory[]
  workSessions  WorkSession[]
  workLogs      WorkLog[]

  @@unique([companyId, documentNumber]) // Same document can't exist twice in the same company
  @@index([companyId, status])
  @@map("employees")
}

// RF-CFG-001: Hourly rate with effective date per employee, history is immutable
model EmployeeRateHistory {
  id            String   @id @default(uuid())
  employeeId    String
  hourlyRate    Decimal  @db.Decimal(10, 2) // Rate in company currency
  effectiveFrom DateTime @default(now())    // When this rate starts to apply
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("employee_rate_history")
}

// RF-EMPL-004 / RF-EMPL-006: Change history for audit trail
model EmployeeChangeHistory {
  id          String   @id @default(uuid())
  employeeId  String
  fieldName   String   // Which field was changed
  oldValue    String?  // Previous value (null for creation)
  newValue    String?  // New value (null for deletion)
  changedBy   String?  // User who made the change (will be populated with auth)
  reason      String?  // Optional reason for the change
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, createdAt])
  @@map("employee_change_history")
}

// RF-JOR-001: Active timer session
model WorkSession {
  id         String   @id @default(uuid())
  employeeId String
  companyId  String
  startedAt  DateTime
  source     String   @default("mobile") // mobile, manual
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, companyId])
  @@map("work_sessions")
}

// RF-JOR-002: Consolidated record of work hours
model WorkLog {
  id               String   @id @default(uuid())
  employeeId       String
  companyId        String
  date             DateTime // The working day
  startTime        DateTime
  endTime          DateTime
  totalHours       Decimal  @db.Decimal(5, 2)
  normalHours      Decimal  @db.Decimal(5, 2)
  extraHours       Decimal  @db.Decimal(5, 2)
  hourlyRate       Decimal? @db.Decimal(10, 2) // Denormalized for historical accuracy (RF-ANA-005)
  totalCost        Decimal? @db.Decimal(12, 2) // Denormalized for analytics performance
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  source           String   @default("timer") // timer, manual
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  history  WorkLogHistory[]

  @@index([employeeId, companyId, date])
  @@map("work_logs")
}

// RF-AUD-001: Audit trail for WorkLog edits
model WorkLogHistory {
  id         String   @id @default(uuid())
  workLogId  String
  changedBy  String   // firebaseUid
  fieldName  String
  oldValue   String?
  newValue   String?
  reason     String?
  createdAt  DateTime @default(now())

  workLog WorkLog @relation(fields: [workLogId], references: [id])

  @@index([workLogId, createdAt])
  @@map("work_log_history")
}

// RF-AUD-001: Generic audit event for the system
model AuditEvent {
  id          String   @id @default(uuid())
  companyId   String
  entityType  String   // COMPANY, EMPLOYEE, MEMBERSHIP, WORK_LOG
  entityId    String
  action      String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  performedBy String   // firebaseUid
  performedAt DateTime @default(now())
  metadata    Json?    // Optional JSON with before/after state

  @@index([companyId, performedAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// RF-EXP-002 / RF-EXP-003: Asynchronous export tracking
model ExportTask {
  id         String   @id @default(uuid())
  companyId  String
  userId     String   // firebaseUid
  type       String   // e.g. "ANALYTICS_EXCEL"
  status     String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  filters    Json?    // Filters used for the export
  fileUrl    String?  // URL to download the file
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, userId])
  @@map("export_tasks")
}
