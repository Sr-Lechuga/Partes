# ==============================================================================
# Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a `.env` (Para Prisma y local)
# 2. Reemplaza los valores con tus credenciales reales
# 3. NUNCA subas el archivo `.env` o `.env.local` a Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (Prisma / PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# URL de conexión a la base de datos PostgreSQL.
# IMPORTANTE para Supabase IPv4 Pooler:
# - DATABASE_URL: Usa el puerto 6543 (Transaction Mode) y agrega `?pgbouncer=true&connection_limit=1`.
# - DIRECT_URL: Usa el puerto 5432 (Session Mode) para que Prisma Migrate funcione correctamente.
# - PASSWORD: Si tu contraseña tiene caracteres especiales (como '$'), escríbelos codificados (ej: '$' -> '%24').

# Ejemplo usando el Pooler de Supabase (IPv4 proxy):
DATABASE_URL="postgresql://postgres.[PROYECTO]:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROYECTO]:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Autenticación (Firebase Auth) - RF-AUTH-001
# ------------------------------------------------------------------------------
# Estas variables serán necesarias para interactuar con Firebase tanto en el frontend como en el backend.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tu-proyecto"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="tu-proyecto.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Credenciales de administrador (Service Account) para verificar JWTs en el Backend (API Routes)
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com"
# IMPORTANTE: Asegúrate de formatear correctamente los saltos de línea (\n) si lo pones en una sola línea
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgk...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Aplicación (Next.js)
# ------------------------------------------------------------------------------
# URL base de la aplicación (útil para links y CORS)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Entorno (development, test, production)
NODE_ENV="development"
